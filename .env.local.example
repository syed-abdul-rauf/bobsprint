# ── IBM Bob Shell ─────────────────────────────────────────────────────────────
# Install: get installer from the IBM Bob Hackathon portal
# Authenticate: bob login   (run once, stores credentials locally)
#
# Override if the binary is not in PATH:
# BOB_COMMAND=bob
#
# Working directory for Bob spawns (defaults to project root):
# BOB_CWD=
#
# Set to 0 if you've already accepted the license interactively:
# BOB_ACCEPT_LICENSE=1

# ── GitHub (Apply stage) ──────────────────────────────────────────────────────
# Create at https://github.com/settings/tokens with "repo" scope.
# Paste into the Settings page (/settings) instead — stored in localStorage,
# not in env vars. This env var is only for CI/scripting use.
# GITHUB_PAT=ghp_...

# ── Dev mode (budget protection) ─────────────────────────────────────────────
# Cap every run to 1 file and skip the Bob safety-gate call.
# Saves ~70% of Bobcoins during development. ALWAYS use during dev runs.
# Comment out before running benchmarks or the final demo.
BOBSPRINT_DEV_MODE=1
