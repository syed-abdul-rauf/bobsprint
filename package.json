{
  "name": "bobsprint",
  "version": "0.1.0",
  "private": true,
  "description": "BobSprint — Paste a GitHub URL. IBM Bob analyzes the repo and opens a draft PR with tests and docs added. Fully audited, in under 5 minutes.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-routes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bridge": "node scripts/bob-bridge.mjs",
    "prepare": "node -e \"process.env.CI && process.exit(0)\" || husky"
  },
  "dependencies": {
    "@types/three": "^0.184.1",
    "clsx": "2.1.1",
    "framer-motion": "^12.0.0",
    "geist": "1.3.1",
    "gsap": "^3.15.0",
    "lucide-react": "0.460.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "2.5.4",
    "three": "^0.184.0",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^2.1.0",
    "autoprefixer": "10.4.20",
    "eslint": "9.14.0",
    "eslint-config-next": "^15.1.0",
    "husky": "^9.1.0",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vitest": "^2.1.0"
  }
}
